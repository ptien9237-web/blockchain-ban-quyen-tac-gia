{
  "name": "bookchain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "dev:all": "concurrently -n \"client,server\" -c \"cyan,magenta\" \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint src server tests",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest --fileParallelism=false",
    "preview": "vite preview",
    "db:migrate": "tsx server/db/runMigration.ts",
    "bootstrap:admin": "tsx server/scripts/bootstrapAdmin.ts",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:node": "hardhat node",
    "contracts:deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "contracts:deploy:sepolia": "hardhat run scripts/deploy.cjs --network sepolia"
  },
  "dependencies": {
    "@types/multer": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.52.0",
    "mssql": "^12.7.4",
    "multer": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "hardhat": "^2.29.1",
    "oxlint": "^1.81.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
