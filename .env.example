# ===============================================================================
# BOOKCHAIN LIBRARY - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and adjust values for your local or production environment.
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ===============================================================================

# -------------------------------------------------------------------------------
# 1. Application Server
# -------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# -------------------------------------------------------------------------------
# 2. Microsoft SQL Server Database Configuration
# -------------------------------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=BookChainLibrary
DB_USER=sa
DB_PASSWORD=your_sql_server_password_here
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false

# -------------------------------------------------------------------------------
# 3. Security & Authentication
# -------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
SESSION_EXPIRES_DAYS=7
COOKIE_SECURE=false

# -------------------------------------------------------------------------------
# 4. File Storage Configuration (Local Disk by default, IPFS optional)
# -------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/books
MAX_UPLOAD_SIZE_MB=50

# -------------------------------------------------------------------------------
# 5. Blockchain Configuration (Local Hardhat Node - Chain ID 31337)
# -------------------------------------------------------------------------------
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_CHAIN_ID=31337
HARDHAT_RPC_URL=http://127.0.0.1:8545
# Optional: Override contract address (defaults to deployments/localhost.json)
# CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Optional: Private key for backend registrar relay transactions
# Defaults on localhost to Hardhat Account #0 (0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
# REGISTRAR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# -------------------------------------------------------------------------------
# 6. Blockchain Testnet (Ethereum Sepolia - Chain ID 11155111 - Optional)
# Required only when testing on public Sepolia testnet or running deploy:sepolia
# -------------------------------------------------------------------------------
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_OR_PUBLIC_RPC
SEPOLIA_PRIVATE_KEY=your_sepolia_private_key_without_0x_prefix_do_not_commit
ETHERSCAN_API_KEY=your_etherscan_api_key_for_contract_verification

# -------------------------------------------------------------------------------
# 7. Decentralized IPFS Storage & Pinata Cloud (Optional)
# Required only if STORAGE_DRIVER=ipfs or using Pinata remote pinning
# -------------------------------------------------------------------------------
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
PINATA_JWT=your_pinata_jwt_token_here
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET=your_pinata_api_secret_here
